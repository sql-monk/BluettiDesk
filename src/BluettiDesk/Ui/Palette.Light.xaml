<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="SeriesInputBrush" Color="#2A78D6"/>
    <SolidColorBrush x:Key="SeriesOutputBrush" Color="#EB6834"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#E4E3DF"/>
    <SolidColorBrush x:Key="ChartTooltipBrush" Color="#FCFCFB"/>
    <SolidColorBrush x:Key="RingTrackBrush" Color="#E4E3DF"/>
    <SolidColorBrush x:Key="StatusGoodBrush" Color="#0CA30C"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FAB219"/>
    <SolidColorBrush x:Key="StatusCriticalBrush" Color="#D03B3B"/>
    <SolidColorBrush x:Key="StatusOffBrush" Color="#9B9A94"/>
    <SolidColorBrush x:Key="AlertWarningBackgroundBrush" Color="#FFF4DB"/>
    <SolidColorBrush x:Key="AlertCriticalBackgroundBrush" Color="#FDECEC"/>
    <SolidColorBrush x:Key="StatusWarningInkBrush" Color="#A86A00"/>
    <SolidColorBrush x:Key="OnWarningBrush" Color="#1A1A19"/>
    <SolidColorBrush x:Key="OnCriticalBrush" Color="#FFFFFF"/>
    <!-- Outage schedule: amber like a lit lamp, slate blue like a dark window; a possible outage is hatched with the dark one -->
    <SolidColorBrush x:Key="OutageOnBrush" Color="#E8A317"/>
    <SolidColorBrush x:Key="OutageOffBrush" Color="#33507A"/>
    <SolidColorBrush x:Key="OutageMaybeSolidBrush" Color="#8FA3C2"/>
    <DrawingBrush x:Key="OutageMaybeBrush" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#DCE3EE" Geometry="M0,0 H6 V6 H0 Z"/>
                <GeometryDrawing Brush="#33507A" Geometry="M0,0 L3,0 L0,3 Z M6,0 L6,3 L3,6 L0,6 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="OutageUnknownBrush" Color="#DEDDD7"/>
    <!-- What the station saw: neutrals where it agrees with the schedule, bright where it does not -->
    <SolidColorBrush x:Key="OutageFactOnBrush" Color="#BDB5A6"/>
    <SolidColorBrush x:Key="OutageFactOffBrush" Color="#57524A"/>
    <SolidColorBrush x:Key="OutageUnplannedOffBrush" Color="#D2501B"/>
    <SolidColorBrush x:Key="OutageUnexpectedOnBrush" Color="#0F8FB0"/>
    <!-- How far the charge of the station carries, under the strip of today -->
    <SolidColorBrush x:Key="OutageReachBrush" Color="#6E6A62"/>
    <SolidColorBrush x:Key="OutageOnInkBrush" Color="#1A1A19"/>
    <SolidColorBrush x:Key="OutageOffInkBrush" Color="#FFFFFF"/>
</ResourceDictionary>
