<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="SeriesInputBrush" Color="#3987E5"/>
    <SolidColorBrush x:Key="SeriesOutputBrush" Color="#D95926"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#3A3A37"/>
    <SolidColorBrush x:Key="ChartTooltipBrush" Color="#1A1A19"/>
    <SolidColorBrush x:Key="RingTrackBrush" Color="#3A3A37"/>
    <SolidColorBrush x:Key="StatusGoodBrush" Color="#0CA30C"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FAB219"/>
    <SolidColorBrush x:Key="StatusCriticalBrush" Color="#D03B3B"/>
    <SolidColorBrush x:Key="StatusOffBrush" Color="#7C7B75"/>
    <SolidColorBrush x:Key="AlertWarningBackgroundBrush" Color="#3A2F14"/>
    <SolidColorBrush x:Key="AlertCriticalBackgroundBrush" Color="#3D1F1F"/>
    <SolidColorBrush x:Key="StatusWarningInkBrush" Color="#FAB219"/>
    <SolidColorBrush x:Key="OnWarningBrush" Color="#1A1A19"/>
    <SolidColorBrush x:Key="OnCriticalBrush" Color="#FFFFFF"/>
    <!-- Outage schedule: amber like a lit lamp, slate blue like a dark window; a possible outage is hatched with the dark one -->
    <SolidColorBrush x:Key="OutageOnBrush" Color="#F2C14E"/>
    <SolidColorBrush x:Key="OutageOffBrush" Color="#5B7FB3"/>
    <SolidColorBrush x:Key="OutageMaybeSolidBrush" Color="#46597A"/>
    <DrawingBrush x:Key="OutageMaybeBrush" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#2F3644" Geometry="M0,0 H6 V6 H0 Z"/>
                <GeometryDrawing Brush="#5B7FB3" Geometry="M0,0 L3,0 L0,3 Z M6,0 L6,3 L3,6 L0,6 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="OutageUnknownBrush" Color="#3A3A37"/>
    <!-- What the station saw: neutrals where it agrees with the schedule, bright where it does not -->
    <SolidColorBrush x:Key="OutageFactOnBrush" Color="#D6CFC1"/>
    <SolidColorBrush x:Key="OutageFactOffBrush" Color="#6A645B"/>
    <SolidColorBrush x:Key="OutageUnplannedOffBrush" Color="#F0703C"/>
    <SolidColorBrush x:Key="OutageUnexpectedOnBrush" Color="#35B9D6"/>
    <!-- How far the charge of the station carries, under the strip of today -->
    <SolidColorBrush x:Key="OutageReachBrush" Color="#C9C4BA"/>
    <SolidColorBrush x:Key="OutageOnInkBrush" Color="#1A1A19"/>
    <SolidColorBrush x:Key="OutageOffInkBrush" Color="#FFFFFF"/>
</ResourceDictionary>
