<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>BluettiDesk</AssemblyName>
    <RootNamespace>BluettiDesk</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>BluettiDesk</Product>
    <!-- ThemeMode (the Fluent look) is still flagged as evaluation API by the SDK. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BluettiDesk.Core\BluettiDesk.Core.csproj" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Windows Forms is here only for the tray icon; its names must not clash with WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
