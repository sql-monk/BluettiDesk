<Window x:Class="BluettiDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BluettiDesk.Ui"
        xmlns:station="clr-namespace:BluettiDesk.Core.Station;assembly=BluettiDesk.Core"
        xmlns:outages="clr-namespace:BluettiDesk.Outages"
        Title="BluettiDesk"
        Icon="Assets/app.ico"
        Width="1040"
        Height="900"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ui:EqualsConverter x:Key="Equals" />
        <ui:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />

        <!-- One queue of a day: the strip, its hours and the times without power -->
        <DataTemplate x:Key="DayRowTemplate">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="0,0,0,4"
                           Visibility="{Binding Title, Converter={StaticResource NullToCollapsed}}" />
                <outages:OutageStrip Segments="{Binding Segments}" NowMinute="{Binding NowMinute}" ShowAxis="True" BarHeight="34" />
                <TextBlock Text="{Binding Detail}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="14,12,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="6,2,6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding TitleText}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding SerialText}" Style="{StaticResource Detail}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="10" Height="10" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource StatusOffBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionStatusKey}" Value="Good">
                                            <Setter Property="Fill" Value="{DynamicResource StatusGoodBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionStatusKey}" Value="Warning">
                                            <Setter Property="Fill" Value="{DynamicResource StatusWarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionText}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastUpdateText}" Style="{StaticResource Detail}" HorizontalAlignment="Right" />
                </StackPanel>
                <Button Grid.Column="2"
                        Content="{Binding ConnectionButtonText}"
                        Command="{Binding ToggleConnectionCommand}"
                        MinWidth="110"
                        VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="1">
                <!-- Why there is no connection, or what failed -->
                <Border Style="{StaticResource Card}"
                        BorderBrush="{DynamicResource StatusWarningBrush}"
                        Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>

                <!-- What is out of range right now, worst first -->
                <ItemsControl ItemsSource="{Binding Alerts}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" BorderThickness="1" Padding="14,10" Margin="6,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AlertWarningBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Key}" Value="Critical">
                                                <Setter Property="Background" Value="{DynamicResource AlertCriticalBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Margin="0,1,12,0" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusWarningInkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Key}" Value="Critical">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Margin="0,2,0,0">
                <TabItem Header="Огляд">
                    <Grid Opacity="{Binding DashboardOpacity}" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="290" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- State of charge -->
                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel VerticalAlignment="Center">
                                <Grid Width="150" Height="150" HorizontalAlignment="Center">
                                    <ui:SocRing Value="{Binding SocValue}" TrackBrush="{DynamicResource RingTrackBrush}">
                                        <ui:SocRing.Style>
                                            <Style TargetType="ui:SocRing">
                                                <Setter Property="RingBrush" Value="{DynamicResource StatusGoodBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SocStatusKey}" Value="Warning">
                                                        <Setter Property="RingBrush" Value="{DynamicResource StatusWarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SocStatusKey}" Value="Critical">
                                                        <Setter Property="RingBrush" Value="{DynamicResource StatusCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SocRing.Style>
                                    </ui:SocRing>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SocText}" FontSize="40" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="%" FontSize="16" Margin="3,0,0,8" VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ActivityText}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding RemainingText}" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding BatteryElectricText}" Style="{StaticResource Detail}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Inputs -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatusCard}" Tag="{Binding AcInputCardKey}">
                            <StackPanel>
                                <TextBlock Text="Вхід AC" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding AcInputPower}" Style="{StaticResource BigValue}" />
                                <TextBlock Text="Немає живлення" Style="{StaticResource Detail}" Visibility="{Binding MainsAbsent, Converter={StaticResource BoolToVisible}}" />
                                <TextBlock Text="{Binding Outages.OverviewText}" Style="{StaticResource Detail}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding Outages.OverviewText, Converter={StaticResource NullToCollapsed}}" />
                                <StackPanel Orientation="Horizontal" Visibility="{Binding MainsPresent, Converter={StaticResource BoolToVisible}}">
                                    <Border Style="{StaticResource Pill}" Tag="{Binding AcInputVoltageKey}">
                                        <TextBlock Text="{Binding AcInputVoltageText}" AutomationProperties.Name="Напруга мережі" />
                                    </Border>
                                    <TextBlock Text="{Binding AcInputCurrentText}" Style="{StaticResource Detail}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Pill}" Tag="{Binding AcInputFrequencyKey}">
                                        <TextBlock Text="{Binding AcInputFrequencyText}" AutomationProperties.Name="Частота мережі" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Вхід DC" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding DcInputPower}" Style="{StaticResource BigValue}" />
                                <TextBlock Text="{Binding DcInputDetail}" Style="{StaticResource Detail}" />
                            </StackPanel>
                        </Border>

                        <!-- Outputs, each with its own switch -->
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource StatusCard}" Tag="{Binding AcOutputCardKey}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Вихід AC" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding AcOutputPower}" Style="{StaticResource BigValue}" />
                                    <TextBlock Text="Вимкнено" Style="{StaticResource Detail}" Visibility="{Binding AcOutputOff, Converter={StaticResource BoolToVisible}}" />
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding AcOutputLive, Converter={StaticResource BoolToVisible}}">
                                        <Border Style="{StaticResource Pill}" Tag="{Binding AcOutputVoltageKey}">
                                            <TextBlock Text="{Binding AcOutputVoltageText}" AutomationProperties.Name="Напруга на виході AC" />
                                        </Border>
                                        <TextBlock Text="{Binding AcOutputCurrentText}" Style="{StaticResource Detail}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Pill}" Tag="{Binding AcOutputFrequencyKey}">
                                            <TextBlock Text="{Binding AcOutputFrequencyText}" AutomationProperties.Name="Частота на виході AC" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <ToggleButton Style="{StaticResource Switch}"
                                              IsChecked="{Binding AcOutputOn, Mode=TwoWay}"
                                              IsEnabled="{Binding CanControl}"
                                              AutomationProperties.Name="Вихід AC"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Вихід DC" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding DcOutputPower}" Style="{StaticResource BigValue}" />
                                    <TextBlock Text="{Binding DcOutputDetail}" Style="{StaticResource Detail}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource Switch}"
                                              IsChecked="{Binding DcOutputOn, Mode=TwoWay}"
                                              IsEnabled="{Binding CanControl}"
                                              AutomationProperties.Name="Вихід DC"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Top" />
                            </Grid>
                        </Border>

                        <!-- Today's schedule, and whether the charge lasts until the grid is back -->
                        <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Visibility="{Binding BackupVisible, Converter={StaticResource BoolToVisible}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <Ellipse>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource StatusOffBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BackupKey}" Value="Good">
                                                        <Setter Property="Fill" Value="{DynamicResource StatusGoodBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BackupKey}" Value="Critical">
                                                        <Setter Property="Fill" Value="{DynamicResource StatusCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE83F;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BackupKey}" Value="Good">
                                                        <Setter Property="Text" Value="&#xE73E;" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BackupKey}" Value="Critical">
                                                        <Setter Property="Text" Value="&#xE7BA;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Заряд і графік відключень" />
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run Text="{Binding BackupTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                                        <Run Text="  " />
                                        <Run Text="{Binding BackupMargin, Mode=OneWay}" FontSize="15" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding BackupDetail}" Style="{StaticResource Detail}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding TodayTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                                    <outages:OutageStrip Segments="{Binding TodaySegments}" NowMinute="{Binding TodayNowMinute}" Reach="{Binding TodayReach}"
                                                         ShowAxis="True" BarHeight="18" EmptyText="На сьогодні графіка немає" />
                                </StackPanel>
                                <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{DynamicResource OutageOnBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Світло є" Style="{StaticResource Detail}" Margin="0,0,14,0" />
                                    <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{DynamicResource OutageOffBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Світла немає" Style="{StaticResource Detail}" Margin="0,0,14,0" />
                                    <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{DynamicResource OutageMaybeBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Можливе відключення" Style="{StaticResource Detail}" Margin="0,0,14,0" />
                                    <Rectangle Width="16" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource OutageReachBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Вистачить заряду" Style="{StaticResource Detail}" Margin="0,0,14,0" />
                                    <Rectangle Width="16" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource StatusCriticalBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Бракує заряду" Style="{StaticResource Detail}" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Power of the last half hour -->
                        <Border Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="200" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Потужність за 30 хв, Вт" Style="{StaticResource SectionTitle}" Margin="0,0,20,0" />
                                    <Rectangle Width="16" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource SeriesInputBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Вхід" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <Rectangle Width="16" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource SeriesOutputBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Вихід" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ui:TimeChart Grid.Row="1"
                                              Margin="0,8,0,0"
                                              Data="{Binding LiveChart}"
                                              EmptyText="Графік з'явиться після підключення"
                                              PrimaryBrush="{DynamicResource SeriesInputBrush}"
                                              SecondaryBrush="{DynamicResource SeriesOutputBrush}"
                                              TextBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                              MutedBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                              GridBrush="{DynamicResource ChartGridBrush}"
                                              TooltipBrush="{DynamicResource ChartTooltipBrush}" />
                            </Grid>
                        </Border>

                        <!-- Settings -->
                        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Налаштування" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Режим заряду" Style="{StaticResource CardTitle}" Margin="0,12,0,4" />
                                <Border BorderThickness="1" CornerRadius="6" BorderBrush="{DynamicResource ChartGridBrush}">
                                    <UniformGrid Columns="3" IsEnabled="{Binding CanControl}">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="ChargingMode" Content="Стандарт"
                                                     IsChecked="{Binding ChargingMode, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static station:ChargingMode.Standard}}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="ChargingMode" Content="Тихий"
                                                     IsChecked="{Binding ChargingMode, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static station:ChargingMode.Silent}}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="ChargingMode" Content="Турбо"
                                                     IsChecked="{Binding ChargingMode, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static station:ChargingMode.Turbo}}" />
                                    </UniformGrid>
                                </Border>
                                <Grid Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Power Lifting" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding PowerLiftingText}" Style="{StaticResource Detail}" />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding PowerLiftingOn, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanControl}"
                                                  AutomationProperties.Name="Power Lifting"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                </Grid>

                                <!-- ECO: the station turns an output off by itself after hours of a light load -->
                                <Grid Margin="0,14,0,0">
                                    <StackPanel Margin="0,0,50,0">
                                        <TextBlock Text="ECO виходу AC" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding AcEcoText}" Style="{StaticResource Detail}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding AcEcoOn, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanControl}"
                                                  AutomationProperties.Name="ECO виходу AC"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <Border Margin="0,6,0,0" BorderThickness="1" CornerRadius="6" BorderBrush="{DynamicResource ChartGridBrush}"
                                        Visibility="{Binding AcEcoOn, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                                    <UniformGrid Columns="4" IsEnabled="{Binding CanControl}">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="AcEcoTimeout" Content="1 год"
                                                     IsChecked="{Binding AcEcoTimeout, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static station:EcoTimeout.OneHour}}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="AcEcoTimeout" Content="2 год"
                                                     IsChecked="{Binding AcEcoTimeout, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static station:EcoTimeout.TwoHours}}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="AcEcoTimeout" Content="3 год"
                                                     IsChecked="{Binding AcEcoTimeout, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static station:EcoTimeout.ThreeHours}}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="AcEcoTimeout" Content="4 год"
                                                     IsChecked="{Binding AcEcoTimeout, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static station:EcoTimeout.FourHours}}" />
                                    </UniformGrid>
                                </Border>
                                <Grid Margin="0,14,0,0">
                                    <StackPanel Margin="0,0,50,0">
                                        <TextBlock Text="ECO виходу DC" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding DcEcoText}" Style="{StaticResource Detail}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding DcEcoOn, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanControl}"
                                                  AutomationProperties.Name="ECO виходу DC"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <Border Margin="0,6,0,0" BorderThickness="1" CornerRadius="6" BorderBrush="{DynamicResource ChartGridBrush}"
                                        Visibility="{Binding DcEcoOn, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                                    <UniformGrid Columns="4" IsEnabled="{Binding CanControl}">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="DcEcoTimeout" Content="1 год"
                                                     IsChecked="{Binding DcEcoTimeout, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static station:EcoTimeout.OneHour}}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="DcEcoTimeout" Content="2 год"
                                                     IsChecked="{Binding DcEcoTimeout, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static station:EcoTimeout.TwoHours}}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="DcEcoTimeout" Content="3 год"
                                                     IsChecked="{Binding DcEcoTimeout, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static station:EcoTimeout.ThreeHours}}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="DcEcoTimeout" Content="4 год"
                                                     IsChecked="{Binding DcEcoTimeout, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static station:EcoTimeout.FourHours}}" />
                                    </UniformGrid>
                                </Border>

                                <Grid Margin="0,14,0,0">
                                    <StackPanel Margin="0,0,50,0">
                                        <TextBlock Text="Запуск разом із Windows" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding AutoStartText}" Style="{StaticResource Detail}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="Запуск разом із Windows"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Battery -->
                        <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatusCard}" Tag="{Binding BatteryCardKey}">
                            <StackPanel>
                                <TextBlock Text="Батарея" Style="{StaticResource SectionTitle}" />
                                <UniformGrid Columns="4" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Здоров'я" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding HealthText}" Style="{StaticResource Stat}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Цикли" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding CyclesText}" Style="{StaticResource Stat}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Температура" Style="{StaticResource CardTitle}" />
                                        <Border Style="{StaticResource StatPill}" Tag="{Binding TemperatureKey}">
                                            <TextBlock Text="{Binding TemperatureText}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Розкид комірок" Style="{StaticResource CardTitle}" />
                                        <Border Style="{StaticResource StatPill}" Tag="{Binding CellSpreadKey}">
                                            <TextBlock Text="{Binding CellSpreadText}" />
                                        </Border>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="Напруга комірок, В" Style="{StaticResource CardTitle}" Margin="0,12,0,4" />
                                <ItemsControl ItemsSource="{Binding CellVoltages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CellPill}" Tag="{Binding Key}">
                                                <TextBlock Text="{Binding Text}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding FirmwareText}" Style="{StaticResource Detail}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Відключення" IsEnabled="{Binding HasOutages}">
                    <StackPanel DataContext="{Binding Outages}" Margin="0,6,0,0">
                        <!-- The address and the way to the site -->
                        <Grid Margin="6,2,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding AddressText}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Detail}">
                                    <Run Text="{Binding QueueText, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="  " />
                                    <Run Text="{Binding SiteText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Змінити адресу" Command="{Binding EditAddressCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Visibility="{Binding ShowEditButton, Converter={StaticResource BoolToVisible}}" />
                            <Button Grid.Column="2" Content="Оновити" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="Сайт ДТЕК" Command="{Binding OpenSiteCommand}" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar IsIndeterminate="True" Height="2" Margin="6,0,6,4" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

                        <!-- What the site said, or that it wants a person to pass its check -->
                        <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource StatusWarningBrush}"
                                Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Button Grid.Column="1" Content="Пройти перевірку" Command="{Binding PassCheckCommand}" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding NeedsCheck, Converter={StaticResource BoolToVisible}}" />
                            </Grid>
                        </Border>

                        <!-- The address, chosen the way the site's form offers it -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}">
                            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                                <TextBlock Text="Адреса" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Почніть вводити назву й виберіть її зі списку, як у формі на сайті ДТЕК. Застосунок стежитиме за графіком цієї адреси й зберігатиме його в журнал." Style="{StaticResource Detail}" TextWrapping="Wrap" Margin="0,2,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Регіон" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Sites}" SelectedItem="{Binding EditSite, Mode=TwoWay}" DisplayMemberPath="Name"
                                              AutomationProperties.Name="Регіон" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="1" Text="Населений пункт" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                    <outages:SuggestBox Grid.Row="1" Grid.Column="1" Text="{Binding CityText, Mode=TwoWay}" Options="{Binding CityOptions}"
                                                        AutomationProperties.Name="Населений пункт" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="2" Text="Вулиця" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                    <outages:SuggestBox Grid.Row="2" Grid.Column="1" Text="{Binding StreetText, Mode=TwoWay}" Options="{Binding StreetOptions}"
                                                        IsEnabled="{Binding StreetEnabled}" AutomationProperties.Name="Вулиця" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="3" Text="Номер будинку" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                    <outages:SuggestBox Grid.Row="3" Grid.Column="1" Text="{Binding HouseText, Mode=TwoWay}" Options="{Binding HouseOptions}"
                                                        IsEnabled="{Binding HouseEnabled}" AutomationProperties.Name="Номер будинку" />
                                </Grid>
                                <TextBlock Text="{Binding EditorHint}" Style="{StaticResource Detail}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Зберегти адресу" Command="{Binding SaveAddressCommand}" IsEnabled="{Binding CanSave}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0" />
                                    <Button Content="Скасувати" Command="{Binding CancelEditCommand}" Visibility="{Binding CanCancelEdit, Converter={StaticResource BoolToVisible}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVisible}}">
                            <!-- The site's own warnings -->
                            <Border CornerRadius="8" BorderThickness="1" Padding="14,10" Margin="6,4"
                                    Background="{DynamicResource AlertWarningBackgroundBrush}" BorderBrush="{DynamicResource StatusWarningBrush}"
                                    Visibility="{Binding AttentionText, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock Text="{Binding AttentionText}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                            <Border CornerRadius="8" BorderThickness="1" Padding="14,10" Margin="6,4"
                                    Background="{DynamicResource AlertCriticalBackgroundBrush}" BorderBrush="{DynamicResource StatusCriticalBrush}"
                                    Visibility="{Binding OutageText, Converter={StaticResource NullToCollapsed}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding OutageTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Visibility="{Binding OutageTitle, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Text="{Binding OutageText}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="8" BorderThickness="1" Padding="14,10" Margin="6,4"
                                    Background="{DynamicResource AlertWarningBackgroundBrush}" BorderBrush="{DynamicResource StatusWarningBrush}"
                                    Visibility="{Binding HiddenText, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock Text="{Binding HiddenText}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>

                            <!-- Now, by the schedule -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding HeroVisible, Converter={StaticResource BoolToVisible}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="52" Height="52" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Ellipse>
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource StatusOffBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HeroKind}" Value="On">
                                                            <Setter Property="Fill" Value="{DynamicResource OutageOnBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HeroKind}" Value="Off">
                                                            <Setter Property="Fill" Value="{DynamicResource OutageOffBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HeroKind}" Value="Maybe">
                                                            <Setter Property="Fill" Value="{DynamicResource OutageMaybeSolidBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE9CE;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource OutageOffInkBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HeroKind}" Value="On">
                                                            <Setter Property="Text" Value="&#xE945;" />
                                                            <Setter Property="Foreground" Value="{DynamicResource OutageOnInkBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HeroKind}" Value="Off">
                                                            <Setter Property="Text" Value="&#xE711;" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HeroKind}" Value="Maybe">
                                                            <Setter Property="Text" Value="&#xE7BA;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HeroKicker}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding HeroTitle}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding HeroNext}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Today and tomorrow -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding ScheduleVisible, Converter={StaticResource BoolToVisible}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TodayTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding TodayRows}" ItemTemplate="{StaticResource DayRowTemplate}" Focusable="False" />
                                    <TextBlock Text="Очікуйте на оновлення графіків" Style="{StaticResource Detail}" Visibility="{Binding TodayEmpty, Converter={StaticResource BoolToVisible}}" />
                                    <TextBlock Text="{Binding TomorrowTitle}" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                                    <ItemsControl ItemsSource="{Binding TomorrowRows}" ItemTemplate="{StaticResource DayRowTemplate}" Focusable="False" />
                                    <TextBlock Text="Інформація від НЕК «Укренерго» про обмеження на наступний день ще не надходила" Style="{StaticResource Detail}" TextWrapping="Wrap"
                                               Visibility="{Binding TomorrowEmpty, Converter={StaticResource BoolToVisible}}" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource OutageOnBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Світло є" Style="{StaticResource Detail}" Margin="0,0,16,0" />
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource OutageOffBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Світла немає" Style="{StaticResource Detail}" Margin="0,0,16,0" />
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource OutageMaybeBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Можливе відключення" Style="{StaticResource Detail}" Margin="0,0,16,0" />
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource OutageUnknownBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Немає даних" Style="{StaticResource Detail}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Schedule against fact -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding ScheduleVisible, Converter={StaticResource BoolToVisible}}">
                                <StackPanel>
                                    <TextBlock Text="Графік і факт" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding ComparisonHint}" Style="{StaticResource Detail}" TextWrapping="Wrap" Margin="0,2,0,6" />
                                    <WrapPanel Margin="0,0,0,6">
                                        <TextBlock Text="Станція:" Style="{StaticResource Detail}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource OutageFactOnBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Світло було" Style="{StaticResource Detail}" Margin="0,0,16,0" />
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource OutageFactOffBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Світла не було" Style="{StaticResource Detail}" Margin="0,0,16,0" />
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource OutageUnplannedOffBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Не було, хоч за графіком мало бути" Style="{StaticResource Detail}" Margin="0,0,16,0" />
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource OutageUnexpectedOnBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Було, хоч за графіком не мало" Style="{StaticResource Detail}" Margin="0,0,16,0" />
                                        <Rectangle Width="14" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource OutageUnknownBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Немає даних" Style="{StaticResource Detail}" />
                                    </WrapPanel>
                                    <TextBlock Text="Порівняння з'явиться, коли в журналі будуть і графік, і дані станції." Style="{StaticResource Detail}"
                                               Visibility="{Binding ComparisonEmpty, Converter={StaticResource BoolToVisible}}" />
                                    <ItemsControl ItemsSource="{Binding Comparison}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,8,0,8">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="Графік" Style="{StaticResource CardTitle}" VerticalAlignment="Top" Margin="0,3,0,0" />
                                                        <outages:OutageStrip Grid.Column="1" Segments="{Binding Plan}" NowMinute="{Binding NowMinute}" BarHeight="20"
                                                                             EmptyText="Графіка на цей день не збережено" Margin="0,0,0,6" />
                                                        <TextBlock Grid.Row="1" Text="Станція" Style="{StaticResource CardTitle}" VerticalAlignment="Top" Margin="0,3,0,0" />
                                                        <outages:OutageStrip Grid.Row="1" Grid.Column="1" Segments="{Binding Fact}" NowMinute="{Binding NowMinute}" BarHeight="20"
                                                                             ShowAxis="True" UnknownAsTrack="True" EmptyText="Даних станції немає" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Detail}" TextWrapping="Wrap" Margin="70,4,0,0" />
                                                    <TextBlock Text="{Binding Versions}" Style="{StaticResource Detail}" TextWrapping="Wrap" Margin="70,2,0,0"
                                                               Visibility="{Binding Versions, Converter={StaticResource NullToCollapsed}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- The long-term plan -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding WeekVisible, Converter={StaticResource BoolToVisible}}">
                                <StackPanel>
                                    <TextBlock Text="План на тиждень" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding WeekRows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <outages:OutageStrip Grid.Column="1" Segments="{Binding Segments}" BarHeight="14" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding MetaText}" Style="{StaticResource Detail}" TextWrapping="Wrap" Margin="8,4,8,8" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Журнал" IsEnabled="{Binding HasJournal}">
                    <Grid DataContext="{Binding Journal}" Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Period and the way out of the app -->
                        <Grid Grid.Row="0" Margin="6,2,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border BorderThickness="1" CornerRadius="6" BorderBrush="{DynamicResource ChartGridBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="30 хв" MinWidth="58"
                                                 IsChecked="{Binding SelectedRange, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static ui:JournalRange.ThirtyMinutes}}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="6 год" MinWidth="58"
                                                 IsChecked="{Binding SelectedRange, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static ui:JournalRange.SixHours}}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="24 год" MinWidth="58"
                                                 IsChecked="{Binding SelectedRange, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static ui:JournalRange.Day}}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="7 днів" MinWidth="58"
                                                 IsChecked="{Binding SelectedRange, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static ui:JournalRange.Week}}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="30 днів" MinWidth="58"
                                                 IsChecked="{Binding SelectedRange, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static ui:JournalRange.Month}}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="Усе" MinWidth="58"
                                                 IsChecked="{Binding SelectedRange, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static ui:JournalRange.All}}" />
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="2" Content="Експорт у CSV…" Command="{Binding ExportCommand}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="Відкрити теку" Command="{Binding OpenFolderCommand}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Power -->
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="240" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Потужність, Вт" Style="{StaticResource SectionTitle}" Margin="0,0,20,0" />
                                    <Rectangle Width="16" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource SeriesInputBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Вхід" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <Rectangle Width="16" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource SeriesOutputBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Вихід" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ui:TimeChart Grid.Row="1"
                                              Margin="0,8,0,0"
                                              Data="{Binding PowerChart}"
                                              PrimaryBrush="{DynamicResource SeriesInputBrush}"
                                              SecondaryBrush="{DynamicResource SeriesOutputBrush}"
                                              TextBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                              MutedBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                              GridBrush="{DynamicResource ChartGridBrush}"
                                              TooltipBrush="{DynamicResource ChartTooltipBrush}" />
                            </Grid>
                        </Border>

                        <!-- Mains voltage: lowest and highest per point, so that a short spike or dip is not averaged away -->
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="200" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Напруга мережі, В" Style="{StaticResource SectionTitle}" Margin="0,0,20,0" />
                                    <Rectangle Width="16" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource SeriesInputBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Найбільша" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <Rectangle Width="16" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource SeriesOutputBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Найменша" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ui:TimeChart Grid.Row="1"
                                              Margin="0,8,0,0"
                                              Data="{Binding MainsChart}"
                                              PrimaryBrush="{DynamicResource SeriesInputBrush}"
                                              SecondaryBrush="{DynamicResource SeriesOutputBrush}"
                                              TextBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                              MutedBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                              GridBrush="{DynamicResource ChartGridBrush}"
                                              TooltipBrush="{DynamicResource ChartTooltipBrush}"
                                              WarningBrush="{DynamicResource StatusWarningBrush}"
                                              CriticalBrush="{DynamicResource StatusCriticalBrush}" />
                                <TextBlock Grid.Row="2" Text="{Binding MainsLimitsText}" Style="{StaticResource Detail}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </Grid>
                        </Border>

                        <!-- Any other logged value -->
                        <Border Grid.Row="3" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="220" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Показник" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox ItemsSource="{Binding Fields}"
                                              SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              MinWidth="340"
                                              MaxDropDownHeight="420"
                                              AutomationProperties.Name="Показник" />
                                </StackPanel>
                                <ui:TimeChart Grid.Row="1"
                                              Margin="0,8,0,0"
                                              Data="{Binding FieldChart}"
                                              PrimaryBrush="{DynamicResource SeriesInputBrush}"
                                              SecondaryBrush="{DynamicResource SeriesOutputBrush}"
                                              TextBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                              MutedBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                              GridBrush="{DynamicResource ChartGridBrush}"
                                              TooltipBrush="{DynamicResource ChartTooltipBrush}"
                                              WarningBrush="{DynamicResource StatusWarningBrush}"
                                              CriticalBrush="{DynamicResource StatusCriticalBrush}" />
                                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Detail}">
                                        <Run Text="{Binding InfoText, Mode=OneWay}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding BucketText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Detail}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</Window>
